<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      PIXEL BRAIN — "Chip" foreground (no-background variant).
      Sits inside the adaptive safe zone with clear padding so it "breathes" under
      Android 16/17's tighter, variable icon-mask shapes (pins stay well clear of
      the edge). A processor (rounded-square die + pins, cyan→magenta gradient) with
      a duotone brain centred on the die at (54,54). Background is transparent.
    -->
    <group android:scaleX="0.75" android:scaleY="0.75" android:pivotX="54" android:pivotY="54">

        <!-- Chip pins (one path, gradient stroke) -->
        <path android:strokeWidth="3.6" android:strokeLineCap="round"
            android:pathData="M42,31 L42,25 M54,31 L54,24 M66,31 L66,25
                              M42,77 L42,83 M54,77 L54,84 M66,77 L66,83
                              M31,42 L25,42 M31,54 L24,54 M31,66 L25,66
                              M77,42 L83,42 M77,54 L84,54 M77,66 L83,66">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="28" android:startY="28" android:endX="80" android:endY="80">
                    <item android:offset="0" android:color="#FF2AEEFF" />
                    <item android:offset="1" android:color="#FFFF4FA3" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Chip die outline -->
        <path android:strokeWidth="4.4" android:strokeLineJoin="round"
            android:pathData="M43,31 H65 A12,12 0 0 1 77,43 V65 A12,12 0 0 1 65,77 H43 A12,12 0 0 1 31,65 V43 A12,12 0 0 1 43,31 Z">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="31" android:startY="31" android:endX="77" android:endY="77">
                    <item android:offset="0" android:color="#FF2AEEFF" />
                    <item android:offset="1" android:color="#FFFF4FA3" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Brain — LEFT lobe (cyan), centred at (54,54) -->
        <path android:pathData="M54,41 C49,39 43,40 40,44 C35,49 36,56 41,59 C38,63 41,68 47,67 C50,69 54,68 54,65 L54,41 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="38" android:startY="41" android:endX="50" android:endY="68">
                    <item android:offset="0" android:color="#FF2AF0FF" />
                    <item android:offset="1" android:color="#FF0093BA" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Brain — RIGHT lobe (magenta) -->
        <path android:pathData="M54,41 C59,39 65,40 68,44 C73,49 72,56 67,59 C70,63 67,68 61,67 C58,69 54,68 54,65 L54,41 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="70" android:startY="41" android:endX="58" android:endY="68">
                    <item android:offset="0" android:color="#FFFF5CB0" />
                    <item android:offset="1" android:color="#FFDE006A" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- fissure + centre node -->
        <path android:strokeColor="#40041018" android:strokeWidth="1.4" android:strokeLineCap="round"
            android:pathData="M54,43 L54,66" />
        <path android:fillColor="#FFFFFFFF" android:pathData="M54,54 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
    </group>
</vector>
