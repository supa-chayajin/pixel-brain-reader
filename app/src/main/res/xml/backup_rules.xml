<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude Git Metadata and potential lock files to prevent restoring stale locks -->
    <exclude domain="file" path="vault/.git" />
    <exclude domain="file" path="vault/.git/index.lock" />
    <exclude domain="file" path="vault/.git/HEAD.lock" />
    <exclude domain="file" path="vault/.git/config.lock" />
    <exclude domain="file" path="vault/.git/refs/heads/master.lock" />
    <exclude domain="file" path="vault/.git/refs/heads/main.lock" />
</full-backup-content>