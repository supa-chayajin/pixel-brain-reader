            android:data="pixelbrain://open?screen=chores" />
    </shortcut>

    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/sc_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long"
        android:shortcutDisabledMessage="@string/shortcut_disabled">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="cloud.wafflecommons.pixelbrainreader"
            android:targetClass="cloud.wafflecommons.pixelbrainreader.MainActivity"
            android:data="pixelbrain://open?screen=chat" />
    </shortcut>
</shortcuts>
