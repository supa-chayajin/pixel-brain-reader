<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Git Metadata and potential lock files -->
        <exclude domain="file" path="vault/.git" />
        <exclude domain="file" path="vault/.git/index.lock" />
        <exclude domain="file" path="vault/.git/HEAD.lock" />
        <exclude domain="file" path="vault/.git/config.lock" />
        <exclude domain="file" path="vault/.git/refs/heads/master.lock" />
        <exclude domain="file" path="vault/.git/refs/heads/main.lock" />
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>